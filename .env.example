# ==============================================================================
# Audiobookphile Backend Environment Variables Reference (.env.example)
# ==============================================================================
# Copy this file to .env.local or .env for local development and CLI operations.
# See docs/ENV.md and DEPLOYMENT.md for deployment and secret provisioning details.

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Project reference ID (e.g. abcdefghijklm)
SUPABASE_PROJECT_ID=your-project-id

# Management API Access Token for CLI and migration push
SUPABASE_ACCESS_TOKEN=sbp_your_management_token

# Canonical Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client operations
SUPABASE_ANON_KEY=your-anon-key

# Service role key for admin and backend tasks (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Secret for securing maintenance endpoints (/api/cron/*)
CRON_SECRET=your-cron-secret-key

# ------------------------------------------------------------------------------
# Storage Backends — Backblaze B2 Multi-Tier
# ------------------------------------------------------------------------------
# Active tier for new uploads: 'primary', 'secondary', 'tertiary', 'quartet', 'quinta'
ACTIVE_B2_TIER=primary

# Primary Tier (B2)
B2_KEY_ID=your-b2-key-id
B2_APP_KEY=your-b2-app-key
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=your-audio-bucket-primary

# Secondary Tier (Optional)
B2_SECONDARY_KEY_ID=
B2_SECONDARY_APP_KEY=
B2_SECONDARY_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_SECONDARY_REGION=us-west-004
B2_SECONDARY_BUCKET_NAME=

# Tertiary Tier (Optional)
B2_TERTIARY_KEY_ID=
B2_TERTIARY_APP_KEY=
B2_TERTIARY_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_TERTIARY_REGION=us-west-004
B2_TERTIARY_BUCKET_NAME=

# ------------------------------------------------------------------------------
# AI & Enrichment Services
# ------------------------------------------------------------------------------
# Zhipu GLM / Z.AI API key for semantic matching and metadata enrichment
ZAI_API_KEY=
# Groq API key (optional fallback for AI adversarial probes)
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Authentication & WebAuthn / Passkeys
# ------------------------------------------------------------------------------
SITE_URL=https://audiobookphile.app
NEXT_PUBLIC_SITE_URL=https://audiobookphile.app
WEBAUTHN_ORIGIN=https://audiobookphile.app
WEBAUTHN_RP_ID=audiobookphile.app
WEBAUTHN_RP_NAME=Audiobookphile

# Secret used to sign 2FA challenge nonces (provisioned in Supabase Edge Secrets)
2FA_CHALLENGE_SIGNING_KEY=your-2fa-challenge-secret

